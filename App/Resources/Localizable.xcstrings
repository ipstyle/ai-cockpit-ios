    "Alle Angaben bleiben auf diesem Gerät. Es gibt kein Konto bei AI Cockpit und keinen Server, der etwas davon zu sehen bekäme.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Angaben bleiben auf diesem Gerät. Es gibt kein Konto bei AI Cockpit und keinen Server, der etwas davon zu sehen bekäme."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything stays on this device. There is no AI Cockpit account and no server that would get to see any of it."
          }
        }
      }
    },
