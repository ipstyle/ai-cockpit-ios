    "Zu finden unter platform.openai.com → Settings → Admin keys. Es muss ein Organisations-Admin-Schlüssel sein; ein gewöhnlicher Projektschlüssel gibt die Kosten nicht heraus.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zu finden unter platform.openai.com → Settings → Admin keys. Es muss ein Organisations-Admin-Schlüssel sein; ein gewöhnlicher Projektschlüssel gibt die Kosten nicht heraus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Found under platform.openai.com → Settings → Admin keys. It has to be an organisation admin key; an ordinary project key does not hand out the cost figures."
          }
        }
      }
    },
