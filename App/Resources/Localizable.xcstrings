          "stringUnit": {
            "state": "translated",
            "value": "Lesen dürfen die Einträge genau zwei Programme: diese App und ihr Widget. Beide sind über dieselbe Zugriffsgruppe signiert; eine andere App auf dem Gerät kann sie nicht öffnen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Exactly two programs may read the entries: this app and its widget. Both are signed with the same access group; no other app on the device can open them."
          }
        }
      }
    },
