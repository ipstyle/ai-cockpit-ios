    "Die Anmeldung gehört nicht zu dieser Anfrage": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Anmeldung gehört nicht zu dieser Anfrage"
