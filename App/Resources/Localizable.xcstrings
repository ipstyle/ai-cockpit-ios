  "strings": {
    "%@\n\n%@\n\nFreiwillig: Ohne diesen Schlüssel bleibt nur diese eine Karte leer, alles andere läuft weiter.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\n\n%@\n\nFreiwillig: Ohne diesen Schlüssel bleibt nur diese eine Karte leer, alles andere läuft weiter."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\n\n%@\n\nOptional: without this key only this one card stays empty, everything else keeps working."
          }
        }
      }
    },
