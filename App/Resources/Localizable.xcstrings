    "Der Code gilt 15 Minuten. Danach fängt die Anmeldung von vorn an.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Code gilt 15 Minuten. Danach fängt die Anmeldung von vorn an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The code is valid for 15 minutes. After that the sign-in starts over."
          }
        }
      }
    },
    "Der Code wurde nicht innerhalb von 15 Minuten eingegeben": {
      "extractionState": "manual",
